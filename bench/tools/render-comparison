#!/usr/bin/env python3
"""Render docs/comparison/claims.yaml into docs/comparison/COMPARISON.md.

Usage:
    bench/tools/render-comparison [--claims PATH] [--out PATH] [--check]

--check exits non-zero if the rendered output would differ from what is
currently committed, without writing anything. Use it in CI to catch a
claims.yaml edit that was not followed by a re-render.

This script has no third-party dependencies beyond PyYAML, which is commonly
available; if PyYAML is missing it falls back to a small embedded YAML
subset parser sufficient for this file's shape (flat scalars, lists of flat
maps, no anchors/tags). The fallback exists so CI/dev boxes without PyYAML
pre-installed can still render the register.
"""
from __future__ import annotations

import argparse
import datetime
import os
import sys

STATUS_LABEL = {
    "yes": "Yes",
    "partial": "Partial",
    "no": "No",
    "unknown": "Unknown",
}

STATUS_ORDER = {"yes": 0, "partial": 1, "unknown": 2, "no": 3}


def load_yaml(path: str):
    try:
        import yaml  # type: ignore

        with open(path, "r", encoding="utf-8") as f:
            return yaml.safe_load(f)
    except ImportError:
        return _load_yaml_fallback(path)


def _load_yaml_fallback(path: str):
    """Minimal parser for this file's specific shape: a top-level mapping of
    scalars, a list of {id,name,tier} gateways, a list of {id,name}
    capabilities, and a list of claim maps with fixed keys. Not a general
    YAML parser."""
    with open(path, "r", encoding="utf-8") as f:
        lines = [l.rstrip("\n") for l in f if not l.strip().startswith("#")]

    def unquote(s: str) -> str:
        s = s.strip()
        if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
            return s[1:-1]
        return s

    doc: dict = {"gateways": [], "capabilities": [], "claims": []}
    i = 0
    section = None
    current: dict = {}
    claim_keys = ("capability", "gateway", "status", "detail", "source_url", "verified_on", "version")
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        if not stripped:
            i += 1
            continue
        if line.startswith("gateways:"):
            section = "gateways"
            i += 1
            continue
        if line.startswith("capabilities:"):
            section = "capabilities"
            i += 1
            continue
        if line.startswith("claims:"):
            section = "claims"
            i += 1
            continue
        if section and stripped.startswith("- "):
            if current:
                doc[section].append(current)
            current = {}
            rest = stripped[2:]
            if ":" in rest:
                k, v = rest.split(":", 1)
                current[k.strip()] = unquote(v)
            i += 1
            continue
        if section and ":" in stripped and current is not None:
            k, v = stripped.split(":", 1)
            current[k.strip()] = unquote(v)
            i += 1
            continue
        i += 1
    if current:
        doc[section].append(current)
    return doc


def render(doc: dict) -> str:
    gateways = doc["gateways"]
    capabilities = doc["capabilities"]
    claims = doc["claims"]

    by_cap_gw = {}
    verified_dates = set()
    for c in claims:
        by_cap_gw[(c["capability"], c["gateway"])] = c
        if c.get("verified_on"):
            verified_dates.add(c["verified_on"])

    harness_gws = [g for g in gateways if g["tier"] in ("harness", "harness-deferred")]
    managed_gws = [g for g in gateways if g["tier"] == "managed"]

    lines = []
    lines.append("<!-- GENERATED FILE. Do not hand-edit. Run `bench/tools/render-comparison` -->")
    lines.append("<!-- after any change to docs/comparison/claims.yaml. -->")
    lines.append("")
    lines.append("# OmniSwitch Competitive Comparison")
    lines.append("")
    lines.append(
        "This table is rendered from `docs/comparison/claims.yaml`, the single "
        "source of truth for every capability claim OmniSwitch makes about "
        "itself or a competitor. See `docs/comparison/README.md` for the "
        "review process. Do not edit this file by hand."
    )
    lines.append("")
    if verified_dates:
        lines.append(f"Last verified: {max(verified_dates)}.")
        lines.append("")
    lines.append(
        "Status legend: **Yes** = confirmed capability, **Partial** = "
        "capability exists with meaningful gaps or scope limits (see Detail), "
        "**No** = confirmed absent, **Unknown** = not independently verified "
        "in available sources (never treated as a claim of absence)."
    )
    lines.append("")

    def render_section(title: str, gws: list, intro: str = ""):
        lines.append(f"## {title}")
        lines.append("")
        if intro:
            lines.append(intro)
            lines.append("")
        for g in gws:
            lines.append(f"### {g['name']} (`{g['id']}`)")
            lines.append("")
            lines.append("| Capability | Status | Detail | Source | Version |")
            lines.append("| --- | --- | --- | --- | --- |")
            for cap in capabilities:
                c = by_cap_gw.get((cap["id"], g["id"]))
                if not c:
                    continue
                status = STATUS_LABEL.get(c["status"], c["status"])
                detail = (c.get("detail") or "").replace("|", "\\|").replace("\n", " ")
                src = c.get("source_url") or ""
                if src:
                    src_cell = f"[link]({src})" if src.startswith("http") else f"`{src}`"
                else:
                    src_cell = ""
                version = (c.get("version") or "").replace("|", "\\|")
                lines.append(
                    f"| {cap['name']} | {status} | {detail} | {src_cell} | {version} |"
                )
            lines.append("")

    render_section(
        "In-harness gateways",
        harness_gws,
        "Self-hosted, open-source gateways that run (or are intended to run) "
        "in the same-host benchmark harness under `bench/`. "
        "`envoy-ai-gateway` is Kubernetes-native and is deferred from the "
        "loopback harness (see `bench/README.md`).",
    )
    render_section(
        "Managed tier",
        managed_gws,
        "Hosted services. Capability rows only -- these are not "
        "self-hostable, so they are never run in the same-host latency "
        "harness.",
    )

    lines.append("## How to regenerate")
    lines.append("")
    lines.append("```")
    lines.append("python3 bench/tools/render-comparison")
    lines.append("```")
    lines.append("")
    return "\n".join(lines) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    here = os.path.dirname(os.path.abspath(__file__))
    repo_root = os.path.abspath(os.path.join(here, "..", ".."))
    parser.add_argument(
        "--claims",
        default=os.path.join(repo_root, "docs", "comparison", "claims.yaml"),
    )
    parser.add_argument(
        "--out",
        default=os.path.join(repo_root, "docs", "comparison", "COMPARISON.md"),
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Do not write; exit 1 if output would differ from --out.",
    )
    args = parser.parse_args()

    doc = load_yaml(args.claims)
    rendered = render(doc)

    if args.check:
        try:
            with open(args.out, "r", encoding="utf-8") as f:
                current = f.read()
        except FileNotFoundError:
            current = ""
        if current != rendered:
            sys.stderr.write(
                f"{args.out} is out of date with {args.claims}; "
                "run bench/tools/render-comparison\n"
            )
            return 1
        return 0

    with open(args.out, "w", encoding="utf-8") as f:
        f.write(rendered)
    print(f"wrote {args.out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
