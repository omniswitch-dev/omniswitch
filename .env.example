# Copy to .env and fill in what you need. Every OMNISWITCH_* variable set here
# overrides the matching key in the config file named by OMNISWITCH_CONFIG, so
# keep overrides commented out unless you mean to change the config file.

# Built-in provider credentials (setting the key registers the provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
# COHERE_API_KEY=

# Azure OpenAI (registered when both the key and endpoint are set)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_MODELS=gpt-4o,gpt-4o-mini   # comma-separated deployment names
# AZURE_OPENAI_API_VERSION=

# AWS Bedrock (registered when the access key and secret key are set)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1                     # falls back to AWS_DEFAULT_REGION, then us-east-1
# OMNISWITCH_BEDROCK_MODELS=               # comma-separated model IDs
# OMNISWITCH_BEDROCK_GUARDRAIL_ID=
# OMNISWITCH_BEDROCK_GUARDRAIL_VERSION=

# OpenAI-compatible presets (setting the key registers the provider)
# MISTRAL_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# PERPLEXITY_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=

# Other credentials referenced through api_key_env in the config file
# GUARDRAIL_API_KEY=

# Gateway runtime
OMNISWITCH_LISTEN=:8080
OMNISWITCH_DATA=.omniswitch
OMNISWITCH_CONFIG=examples/gateway-config.yaml
# Authentication. Leave unset to use gateway.auth from the config file (the
# example config enables it). Without a config file auth is off, and the
# gateway then listens on 127.0.0.1 only unless OMNISWITCH_LISTEN is set.
# OMNISWITCH_AUTH=true
# Required for the first startup when OMNISWITCH_AUTH=true and the database has no keys.
# Keep this in a secret manager; it is hashed before storage and is never logged.
OMNISWITCH_BOOTSTRAP_API_KEY=
OMNISWITCH_BOOTSTRAP_WORKSPACE=
OMNISWITCH_BOOTSTRAP_ROLE=owner
OMNISWITCH_CACHE_THRESHOLD=0.95
OMNISWITCH_CACHE_TTL=24h
OMNISWITCH_CACHE_SCOPE=api_key
OMNISWITCH_LOG_PAYLOADS=false
OMNISWITCH_CORS_ORIGINS=
OMNISWITCH_GUARDRAIL_STREAM_BUFFER=true
OMNISWITCH_MAX_REQUEST_BYTES=10485760
OMNISWITCH_READ_HEADER_TIMEOUT=5s
OMNISWITCH_READ_TIMEOUT=30s
# Keep zero for streaming responses, or set an explicit limit for non-streaming-only deployments.
OMNISWITCH_WRITE_TIMEOUT=0s
OMNISWITCH_IDLE_TIMEOUT=60s
OMNISWITCH_CIRCUIT_BREAKER_FAILURES=5
OMNISWITCH_CIRCUIT_BREAKER_COOLDOWN=60s
# OMNISWITCH_SHADOW_PROVIDER=
# Shared Postgres store (postgres:// or postgresql:// URL). Empty uses SQLite
# in OMNISWITCH_DATA.
# OMNISWITCH_DATABASE_URL=
# A/B test definition, see docs/CONFIGURATION.md.
# OMNISWITCH_AB_TEST=
# Time budget for in-flight requests to finish after SIGINT/SIGTERM before the
# server force-closes. `omniswitch serve` exits 0 once draining completes.
OMNISWITCH_SHUTDOWN_TIMEOUT=30s
# Set true only for local smoke-testing without any provider configured;
# GET /readyz reports not-ready when no providers are registered otherwise.
OMNISWITCH_ALLOW_NO_PROVIDERS=false
# Delete request logs, guardrail events and shadow requests older than this
# many days (checked hourly). Unset or 0 keeps them forever. The current UTC
# month is always kept, because monthly key budgets are computed from it.
# Expired semantic-cache entries are deleted hourly in every case.
OMNISWITCH_LOG_RETENTION_DAYS=0

# Request quotas. Leave Redis empty for the process-local sliding window;
# configure Redis to coordinate quota enforcement across gateway replicas.
OMNISWITCH_RATE_LIMIT_REQUESTS=120
OMNISWITCH_RATE_LIMIT_WINDOW=1m
OMNISWITCH_RATE_LIMIT_REDIS_URL=
OMNISWITCH_RATE_LIMIT_PREFIX=omniswitch:ratelimit
OMNISWITCH_RATE_LIMIT_FAIL_OPEN=false

# OIDC/JWT workload identity. Local API keys remain valid during migration.
# Configuring a JWKS URL enables authentication automatically.
OMNISWITCH_OIDC_JWKS_URL=
OMNISWITCH_OIDC_ISSUER=
OMNISWITCH_OIDC_AUDIENCE=
OMNISWITCH_OIDC_ROLE_CLAIM=role
OMNISWITCH_OIDC_WORKSPACE_CLAIM=workspace_id
OMNISWITCH_OIDC_ORGANIZATION_CLAIM=organization_id
OMNISWITCH_OIDC_CACHE_TTL=5m

# Provider credential vault
# Set this before creating virtual provider keys so encrypted credentials survive restarts.
OMNISWITCH_VAULT_KEY=

# OpenTelemetry trace export
OMNISWITCH_OTEL_ENABLED=false
OMNISWITCH_OTEL_ENDPOINT=
OMNISWITCH_OTEL_SERVICE_NAME=omniswitch-gateway
OMNISWITCH_OTEL_HEADERS=
OMNISWITCH_OTEL_INSECURE=true
OMNISWITCH_OTEL_TIMEOUT=10s
OMNISWITCH_PROMETHEUS_ENABLED=true

# MCP policy gateway (disabled by default). Uncomment to try it locally. With no
# OMNISWITCH_MCP_POLICY set, an embedded conservative default policy is used.
# OMNISWITCH_MCP_ENABLED=true
# OMNISWITCH_MCP_POLICY=policies/production-delete.yaml
# OMNISWITCH_MCP_UPSTREAM=http://127.0.0.1:8090/mcp
